{
  "name": "zine-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build": "tsc -b && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler preview",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "heic2any": "^0.0.4",
    "idb-keyval": "^6.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "description": "Arma zines y photobooks para imprimir. Las fotos nunca salen de tu dispositivo.",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0"
}
