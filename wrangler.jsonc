{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zine-studio",
  "compatibility_date": "2026-10-14",
  // Static assets only: no Worker script, no bindings, nowhere to upload to.
  "assets": {
    "not_found_handling": "single-page-application"
  },
  // Served on workers.dev; branch Previews come from `wrangler preview` in Workers Builds.
  "workers_dev": true,
  "preview_urls": true
}
